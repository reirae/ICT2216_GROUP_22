# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Session
SESSION_SECRET=replace_with_a_long_random_string_min_32_chars
SESSION_COOKIE_NAME=securebank.sid
SESSION_MAX_AGE_MS=900000

# Database (MySQL through SSH tunnel or direct)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=secureBankAdmin
DB_PASSWORD=Password123!
DB_NAME=SecureBank
DB_CONNECTION_LIMIT=10

# Rate limiting
LOGIN_RL_WINDOW_MS=900000
LOGIN_RL_MAX=5

# Account lock policy
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_MINUTES=15

# Optional SSH tunnel (consumed by scripts/sshTunnel.js)
# Leave blank if you connect to MySQL directly.
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
SSH_PRIVATE_KEY_PATH=
DB_HOST_REMOTE=127.0.0.1
DB_LOCAL_PORT=3306
